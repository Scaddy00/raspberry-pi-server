[Unit]
Description=Python Applications Auto-Start Manager
After=network.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__INSTALL_DIR__/app_manager
ExecStart=/bin/bash __INSTALL_DIR__/app_manager/manage_apps.sh start
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
