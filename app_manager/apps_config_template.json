{
  "apps": {
    "example_app": {
      "script_path": "apps/example_app/main.py",
      "screen_name": "pyapp_example_app",
      "description": "Example Python application"
    },
    "example_app_with_venv": {
      "script_path": "apps/example_app_with_venv/main.py",
